# MongoDB
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_INITDB_USER_DATABASE=userdb
MONGO_INITDB_PRODUCT_DATABASE=productdb

# Eureka
EUREKA_SERVER_PORT=8761
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka-server:8761/eureka/

# Services Configuration
SPRING_PROFILES_ACTIVE=docker

# API Gateway
GATEWAY_PORT=8080
GATEWAY_HOST=api-gateway

# User Service
USER_SERVICE_PORT=8081
USER_SERVICE_HOST=user-service
SPRING_DATA_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/${MONGO_INITDB_USER_DATABASE}?authSource=admin

# Product Service
PRODUCT_SERVICE_PORT=8082
PRODUCT_SERVICE_HOST=product-service
PRODUCT_SERVICE_DB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/${MONGO_INITDB_PRODUCT_DATABASE}?authSource=admin

# JWT Configuration
JWT_SECRET=ma_cle_secrete_buy-01_jeanga7_very_secure_key_123456789
JWT_EXPIRATION=86400000  # 24h en millisecondes

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=product-group
ZOOKEEPER_PORT=2181
