                  "if (response && response.message) {",
                  "    pm.test(\"Response contains success message\", function() {",
                  "        pm.expect(response.message).to.include('Session révoquée');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
