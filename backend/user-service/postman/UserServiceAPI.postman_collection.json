  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Admin User (First Time Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n    \\\"name\\\": \\\"Admin User\\\",\\n    \\\"email\\\": \\\"admin@example.com\\\",\\n    \\\"password\\\": \\\"admin123\\\",\\n    \\\"avatar\\\": \\\"https://www.gravatar.com/avatar/admin\\\",\\n    \\\"role\\\": \\\"ADMIN\\\"\\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function() {",
                  "    pm.response.to.have.status(201);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (response && response.token) {",
                  "    pm.environment.set(\"admin_token\", response.token);",
                  "    pm.environment.set(\"admin_user_id\", response.user ? response.user.id : null);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Schéma de base pour un utilisateur",
                  "pm.test('La réponse a un schéma valide', function() {",
                  "    const userSchema = {\n          type: 'object',\n          properties: {\n            id: { type: 'string' },\n            name: { type: 'string' },\n            email: { type: 'string', format: 'email' },\n            role: { type: 'string', enum: ['CLIENT', 'SELLER', 'ADMIN'] },\n            avatar: { type: 'string', format: 'uri' },\n            createdAt: { type: 'string', format: 'date-time' },\n            updatedAt: { type: 'string', format: 'date-time' }\n          },\n          required: ['id', 'name', 'email', 'role', 'createdAt', 'updatedAt']\n        };\n        \n        pm.response.to.have.jsonSchema(userSchema);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n    \\\"email\\\": \\\"admin@example.com\\\",\\n    \\\"password\\\": \\\"admin123\\\"\\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (response && response.token) {",
                  "    pm.environment.set(\"admin_token\", response.token);",
                  "    pm.environment.set(\"admin_user_id\", response.user ? response.user.id : null);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register Regular User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n    \\\"name\\\": \\\"John Doe\\\",\\n    \\\"email\\\": \\\"user@example.com\\\",\\n    \\\"password\\\": \\\"user123\\\",\\n    \\\"avatar\\\": \\\"https://www.gravatar.com/avatar/user\\\"\\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (response && response.token) {",
                  "    pm.environment.set(\"user_token\", response.token);",
                  "    pm.environment.set(\"regular_user_id\", response.user ? response.user.id : null);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"deviceId\": \"{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (response && response.message) {",
                  "    pm.test(\"Response contains success message\", function() {",
                  "        pm.expect(response.message).to.include('Déconnexion réussie');",
                  "    });",
                  "}",
                  "",
                  "// Supprimer le token de l'environnement après la déconnexion",
                  "pm.environment.unset(\"user_token\");"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Active Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "sessions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (Array.isArray(response)) {",
                  "    pm.test(\"Response is an array of sessions\", function() {",
                  "        pm.expect(response).to.be.an('array');",
                  "    });",
                  "    ",
                  "    if (response.length > 0) {",
                  "        const session = response[0];",
                  "        pm.test(\"Session has required fields\", function() {",
                  "            pm.expect(session).to.have.property('id');",
                  "            pm.expect(session).to.have.property('deviceId');",
                  "            pm.expect(session).to.have.property('ipAddress');",
                  "            pm.expect(session).to.have.property('userAgent');",
                  "            pm.expect(session).to.have.property('createdAt');",
                  "            pm.expect(session).to.have.property('lastActivity');",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Revoke Session",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/sessions/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "sessions", "{{session_id}}"],
              "variable": [
                {
                  "key": "session_id",
                  "value": "",
                  "description": "ID de la session à révoquer"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
